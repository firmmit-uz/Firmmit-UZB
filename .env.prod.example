# === JONLI SERVER sozlamasi ===
# Buni `.env` deb nusxa oling va qiymatlarni to'ldiring (repo ildizida):
#   cp .env.prod.example .env

# Domen (Caddy uchun, avtomatik SSL). Domen bo'lmasa sinov uchun: :80
SITE_DOMAIN=firmmit.example.com

# Django
DJANGO_SECRET_KEY=BU-YERGA-UZUN-TASODIFIY-MAXFIY-KALIT
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=firmmit.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://firmmit.example.com
# Frontend bir xil domenda bo'lgani uchun CORS shart emas
DJANGO_CORS_ORIGINS=

# Database
POSTGRES_DB=firmmit
POSTGRES_USER=firmmit
POSTGRES_PASSWORD=BU-YERGA-KUCHLI-BAZA-PAROLI
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# Til va vaqt
DJANGO_LANGUAGE_CODE=uz
DJANGO_TIME_ZONE=Asia/Tashkent
