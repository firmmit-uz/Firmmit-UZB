# Caddy — avtomatik HTTPS (Let's Encrypt) + frontend + backend proksi.
# SITE_DOMAIN muhit o'zgaruvchisi (.env) orqali beriladi.
# Domen bo'lmasa (faqat IP bilan sinov uchun): SITE_DOMAIN=:80 qo'ying (SSL bo'lmaydi).
{$SITE_DOMAIN} {
	encode gzip

	# Backend API va admin panel
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /admin/* {
		reverse_proxy backend:8000
	}

	# Django statik (admin uslublari) va yuklangan media
	handle_path /static/* {
		root * /srv/static
		file_server
	}
	handle_path /media/* {
		root * /srv/media
		file_server
	}

	# ================= VAQTINCHA: SAYT TO'XTATILGAN ("Tayyorgarlik ko'rilmoqda") =================
	# Barcha sahifalar maintenance/index.html ga yo'naltiriladi (HTTP 503 = vaqtincha yopiq,
	# qidiruv tizimlari saytni o'chirib yubormaydi). /api, /admin, /static, /media ishlayveradi.
	# SAYTNI QAYTA OCHISH: quyidagi ikki "handle" blokini o'chirib, pastdagi asl blokdan
	# "#" belgilarini olib tashlang, so'ng serverda:  docker exec firmmit-uzb-caddy-1 caddy reload --config /etc/caddy/Caddyfile
	handle /maintenance/* {
		root * /srv/site
		file_server
	}
	handle {
		root * /srv/site
		header Cache-Control "no-store"
		header Retry-After "86400"
		rewrite * /maintenance/index.html
		file_server {
			status 503
		}
	}

	# --- Asl frontend bloki (sayt ochiq bo'lganda) ---
	# handle {
	# 	root * /srv/site
	#
	# 	# HTML/JS/CSS — brauzer har safar serverdan yangiligini tekshirsin.
	# 	# (ETag orqali: o'zgarmagan bo'lsa 304, o'zgargan bo'lsa yangi versiya.)
	# 	# Shu tufayli sayt yangilangач foydalanuvchi darhol ko'radi, kesh ilashib qolmaydi.
	# 	@revalidate {
	# 		path *.html *.js *.css
	# 	}
	# 	header @revalidate Cache-Control "no-cache"
	#
	# 	try_files {path} {path}/index.html {path}.html /index.html
	# 	file_server
	# }
}
